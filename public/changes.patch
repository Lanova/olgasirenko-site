+/* Calm Editorial — 12 colours per theme. Violet leads, cyan supports.
+   Core: canvas · card · line · ink · body · muted · violet · violet-wash · cyan · cyan-wash · success · error.
+   Everything else below is an alias of those. */
+:root{
+  color-scheme:light;
+  --paper:#FBFAF8;--card:#FFFFFF;--line:#E4E2DC;
+  --ink:#001A34;--ink-2:#2C3446;--muted:#64637A;
+  --violet:#542CB7;--violet-wash:#F1ECFC;
+  --cyan:#0A6B84;--cyan-wash:#E4F5F5;
+  --success:#0F7A55;--error:#BA1A1A;
+  --text-on-accent:#FFFFFF;
+
+  /* code (always-dark surface, both themes) */
+  --codebg:#001A34;--code-fg:#DDE4F2;--code-tag:#52F8F4;--code-hl:#9CFBF8;--code-var:#C3B0F5;--code-comment:#8A93AC;
+  --night:#0B1B30;--night-deep:#02101F;
+
+  /* aliases — kept for component compatibility, no new values */
+  --paper-2:var(--card);
+  --control-border:var(--muted);
+  --violet-2:var(--violet);--violet-action:var(--violet);
+  --cyan-text:var(--cyan);--cyan-dim:var(--cyan);--cyan-wash-line:var(--line);
+  --slate:var(--muted);--slate-wash:var(--line);
+  --success-wash:color-mix(in srgb,var(--success) 12%,transparent);
+  --error-wash:color-mix(in srgb,var(--error) 12%,transparent);
